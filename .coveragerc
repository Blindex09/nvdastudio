[run]
source = addon/globalPlugins/nvdastudio
omit =
    addon/globalPlugins/nvdastudio/lib/*
    */__pycache__/*
    */tests/*
branch = True

# fail_under e um PISO (regressao), nao uma meta ja atingida -- cobertura
# real medida em 2026-09-12 foi 65.28%. Setado a 60% (margem de folga contra
# flutuacao normal entre execucoes) para pegar quedas reais sem travar
# commits legitimos. Suba este numero conforme a cobertura real sobe --
# nunca abaixe pra "fazer passar". O piso so vale se alguem o avaliar: o job
# de testes do CI roda `pytest --cov`, que aplica este numero.
[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
fail_under = 60
show_missing = True
skip_covered = False

[html]
directory = .coverage_html
